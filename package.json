{
  "name": "courseplatform-qa",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "Local browser QA dependencies for CoursePlatform",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "sync:frontend": "node scripts/sync_frontend.cjs",
    "check:frontend": "node scripts/sync_frontend.cjs --check",
    "qa:certificates": "node scripts/verify_certificate_browser.cjs",
    "qa:password-recovery": "node scripts/verify_password_recovery_browser.cjs",
    "qa:assessment-feedback": "node scripts/verify_assessment_feedback.cjs",
    "qa:submission-retry": "node scripts/verify_submission_retry.cjs",
    "qa:participation-policy": "node scripts/verify_participation_policy.cjs",
    "qa:payment-receipt-preview": "node scripts/verify_payment_receipt_preview.cjs",
    "qa:course-editions": "node scripts/verify_course_editions_browser.cjs",
    "qa:stage7-lists": "node scripts/verify_stage7_admin_lists.cjs",
    "qa:staff-assignment": "node scripts/verify_staff_assignment_browser.cjs",
    "qa:student-dashboard": "node scripts/verify_student_dashboard_resilience.cjs",
    "qa:stage12-ui": "node scripts/verify_stage12_navigation_accessibility.cjs",
    "qa:stage12-accessibility": "node scripts/verify_stage12_navigation_accessibility.cjs",
    "qa:stage12-admin": "node scripts/verify_stage7_admin_lists.cjs",
    "qa:api-config": "node scripts/verify_api_configuration.cjs",
    "qa:typed-api-client": "node scripts/verify_versioned_api_client.cjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
