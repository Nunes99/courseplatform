# Opcao 1, recomendada:
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Opcao 2, se o Vercel/Supabase disponibilizar variaveis separadas:
# POSTGRES_HOST=aws-0-region.pooler.supabase.com
# POSTGRES_DATABASE=postgres
# POSTGRES_USER=postgres.PROJECT_REF
# POSTGRES_PASSWORD=PASSWORD
# POSTGRES_PORT=6543

# Opcao 3, fallback com host direto do projeto:
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# POSTGRES_PASSWORD=PASSWORD

DEFAULT_COURSE_ID=COURSE-EAPI-001
SESSION_HOURS=12
DB_CONNECT_TIMEOUT=15
DB_CONNECT_RETRIES=3
CORS_ORIGINS=https://nunes99.github.io,https://nunes99.github.io/courseplatform,https://courseplatform-mauve.vercel.app

# Recuperacao emergencial de administradores.
# Recomendado: guardar apenas o hash SHA-256 da chave.
# Gerar hash localmente:
# python -c "import hashlib; print(hashlib.sha256('SUA-CHAVE-FORTE'.encode()).hexdigest())"
ADMIN_RECOVERY_KEY_HASH=

# Apenas para desenvolvimento controlado; em producao prefira ADMIN_RECOVERY_KEY_HASH.
# ADMIN_RECOVERY_KEY=

# Notificacoes pelo WhatsApp Business Cloud API (opcional).
# O modelo aprovado deve receber quatro variaveis no corpo:
# {{1}} nome do estudante, {{2}} titulo, {{3}} mensagem, {{4}} link da plataforma.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
# Chave legada; novas instalacoes devem usar NOTIFICATION_CONFIG_ENCRYPTION_KEY.
WHATSAPP_CONFIG_ENCRYPTION_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_PT
WHATSAPP_PLATFORM_URL=https://nunes99.github.io/courseplatform/
WHATSAPP_TIMEOUT_SECONDS=12

# URL publica usada nos links enviados por Email e Telegram.
PLATFORM_URL=https://nunes99.github.io/courseplatform/

# Chave aleatoria com pelo menos 32 bytes, apenas no servidor. Protege os
# tokens/palavras-passe de todos os canais guardados pelo painel administrativo.
NOTIFICATION_CONFIG_ENCRYPTION_KEY=

# Email SMTP (opcional; tambem configuravel pelo painel).
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=12

# Telegram Bot API (opcional; tambem configuravel pelo painel).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_TIMEOUT_SECONDS=12
# Web Push / PWA (opcional).
# Gere um par persistente com: python scripts/generate_vapid_keys.py
# VAPID_SUBJECT deve ser um mailto: ou URL HTTPS de contacto. Nunca exponha a
# chave privada no frontend nem gere um novo par a cada publicacao.
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
WEB_PUSH_TTL_SECONDS=86400
WEB_PUSH_TIMEOUT_SECONDS=12
