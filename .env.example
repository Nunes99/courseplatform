# Opcao 1, recomendada para a API depois de aplicar a migracao da role runtime:
# No pooler, o utilizador personalizado usa o formato ROLE.PROJECT_REF.
DATABASE_URL=postgresql://courseplatform_api.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Opcao 2, se o Vercel/Supabase disponibilizar variaveis separadas:
# POSTGRES_HOST=aws-0-region.pooler.supabase.com
# POSTGRES_DATABASE=postgres
# POSTGRES_USER=courseplatform_api.PROJECT_REF
# POSTGRES_PASSWORD=PASSWORD
# POSTGRES_PORT=6543

# Opcao 3, fallback administrativo legado. Nao recomendado para o runtime:
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# POSTGRES_PASSWORD=PASSWORD

# Storage administrativo para logotipos, assinaturas e elementos gráficos.
# Prefira SUPABASE_SECRET_KEY. A SERVICE_ROLE_KEY legada continua aceite.
# Ambas são secretas e devem existir apenas no backend/Vercel.
# Sem estas variáveis, o ficheiro continua persistido com segurança no
# MEDIA_CONFIG da base de dados, mas não é criada uma cópia adicional no Storage.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CERTIFICATE_BUCKET=courseplatform-certificate-assets
SUPABASE_SUBMISSION_BUCKET=courseplatform-submissions
SUPABASE_PAYMENT_RECEIPT_BUCKET=courseplatform-payment-receipts
SUBMISSION_FILE_MAX_BYTES=10485760
PAYMENT_RECEIPT_MAX_BYTES=5242880
STORAGE_LEGACY_READ_MAX_BYTES=26214400
SUPABASE_STORAGE_TIMEOUT_SECONDS=30
# Os dois uploads privados falham de forma explícita quando SUPABASE_URL ou uma
# chave secreta de servidor não estiverem configuradas no backend.

# Validação read-only de downloads publicados. Use apenas sessões sintéticas ou
# contas de teste controladas e nunca envie estes tokens para o Git.
COURSEPLATFORM_VALIDATION_BASE_URL=
COURSEPLATFORM_VALIDATION_STUDENT_TOKEN=
COURSEPLATFORM_VALIDATION_REVIEWER_TOKEN=
COURSEPLATFORM_VALIDATION_ADMIN_TOKEN=

# Chat instantaneo com Supabase Realtime (opcional, recomendado).
# A chave publicavel pode ser exposta ao navegador; a chave JWT nunca pode sair
# do backend. Em projetos legados, SUPABASE_ANON_KEY e SUPABASE_JWT_SECRET
# continuam aceites como alternativas. Execute tambem supabase/chat_realtime.sql.
CHAT_REALTIME_ENABLED=true
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  # tambem aceite quando ja existe no projeto
# SUPABASE_ANON_KEY=
SUPABASE_REALTIME_JWT_SECRET=
# SUPABASE_JWT_SECRET=
CHAT_REALTIME_TOKEN_MINUTES=30

DEFAULT_COURSE_ID=COURSE-EAPI-001
SESSION_HOURS=12
# Recuperação de estudantes. PASSWORD_RESET_HASH_KEY deve ser uma chave aleatória
# com pelo menos 32 bytes e permanecer apenas no servidor.
PASSWORD_RESET_HASH_KEY=
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_ACCOUNT_LIMIT=3
PASSWORD_RESET_ACCOUNT_WINDOW_MINUTES=30
PASSWORD_RESET_SOURCE_LIMIT=10
PASSWORD_RESET_SOURCE_WINDOW_MINUTES=60
PASSWORD_RESET_COMPLETION_LIMIT=20
PASSWORD_RESET_COMPLETION_WINDOW_MINUTES=15
DB_CONNECT_TIMEOUT=15
DB_CONNECT_RETRIES=3
CORS_ORIGINS=https://nunes99.github.io,https://nunes99.github.io/courseplatform,https://courseplatform-mauve.vercel.app

# Recuperacao emergencial de administradores.
# Recomendado: guardar apenas o hash SHA-256 da chave.
# Gerar hash localmente:
# python -c "import hashlib; print(hashlib.sha256('SUA-CHAVE-FORTE'.encode()).hexdigest())"
ADMIN_RECOVERY_KEY_HASH=

# Apenas para desenvolvimento controlado; em producao prefira ADMIN_RECOVERY_KEY_HASH.
# ADMIN_RECOVERY_KEY=

# Notificacoes pelo WhatsApp Business Cloud API (opcional).
# O modelo aprovado deve receber quatro variaveis no corpo:
# {{1}} nome do estudante, {{2}} titulo, {{3}} mensagem, {{4}} link da plataforma.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
# Chave legada; novas instalacoes devem usar NOTIFICATION_CONFIG_ENCRYPTION_KEY.
WHATSAPP_CONFIG_ENCRYPTION_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_PT
WHATSAPP_PLATFORM_URL=https://nunes99.github.io/courseplatform/
WHATSAPP_TIMEOUT_SECONDS=12

# URL publica usada nos links enviados por Email e Telegram.
PLATFORM_URL=https://nunes99.github.io/courseplatform/

# Chave aleatoria com pelo menos 32 bytes, apenas no servidor. Protege os
# tokens/palavras-passe de todos os canais guardados pelo painel administrativo.
NOTIFICATION_CONFIG_ENCRYPTION_KEY=

# Email SMTP (opcional; tambem configuravel pelo painel).
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=12

# Telegram Bot API (opcional; tambem configuravel pelo painel).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_TIMEOUT_SECONDS=12
# Web Push / PWA (opcional).
# Gere um par persistente com: python scripts/generate_vapid_keys.py
# VAPID_SUBJECT deve ser um mailto: ou URL HTTPS de contacto. Nunca exponha a
# chave privada no frontend nem gere um novo par a cada publicacao.
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
WEB_PUSH_TTL_SECONDS=86400
WEB_PUSH_TIMEOUT_SECONDS=12
