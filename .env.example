# Opcao 1, recomendada:
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Opcao 2, se o Vercel/Supabase disponibilizar variaveis separadas:
# POSTGRES_HOST=aws-0-region.pooler.supabase.com
# POSTGRES_DATABASE=postgres
# POSTGRES_USER=postgres.PROJECT_REF
# POSTGRES_PASSWORD=PASSWORD
# POSTGRES_PORT=6543

# Opcao 3, fallback com host direto do projeto:
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# POSTGRES_PASSWORD=PASSWORD

DEFAULT_COURSE_ID=COURSE-EAPI-001
SESSION_HOURS=12
DB_CONNECT_TIMEOUT=15
DB_CONNECT_RETRIES=3
CORS_ORIGINS=https://nunes99.github.io,https://nunes99.github.io/courseplatform,https://courseplatform-mauve.vercel.app

# Recuperacao emergencial de administradores.
# Recomendado: guardar apenas o hash SHA-256 da chave.
# Gerar hash localmente:
# python -c "import hashlib; print(hashlib.sha256('SUA-CHAVE-FORTE'.encode()).hexdigest())"
ADMIN_RECOVERY_KEY_HASH=

# Apenas para desenvolvimento controlado; em producao prefira ADMIN_RECOVERY_KEY_HASH.
# ADMIN_RECOVERY_KEY=

# Notificacoes pelo WhatsApp Business Cloud API (opcional).
# O modelo aprovado deve receber quatro variaveis no corpo:
# {{1}} nome do estudante, {{2}} titulo, {{3}} mensagem, {{4}} link da plataforma.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
# Chave aleatoria com pelo menos 32 bytes, usada apenas no servidor para encriptar tokens guardados pelo painel.
WHATSAPP_CONFIG_ENCRYPTION_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_PT
WHATSAPP_PLATFORM_URL=https://nunes99.github.io/courseplatform/
WHATSAPP_TIMEOUT_SECONDS=12
